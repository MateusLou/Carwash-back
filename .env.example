# Copie para .env e preencha. O .env não vai para o Git.
ENVIRONMENT="dev"

# URL do carwash-front em produção (em dev, o código já usa http://localhost:5173)
CLIENT_URL="https://seu-dashboard.vercel.app"

# ----------------------------------------------------------------------------
# Postgres do Supabase — painel: Connect > ORMs/URI
#
# Jeito recomendado: colar a URI inteira do painel, aba "Session pooler".
#   DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"
#
# Qual conexão escolher:
#   • Session pooler (5432) ....... use esta. Funciona em rede só-IPv4 e o
#     Alembic roda normal.
#   • Direct connection (5432) .... host db.<ref>.supabase.co, resolve só em
#     IPv6. Sem rota IPv6 na máquina, nem chega a conectar.
#   • Transaction pooler (6543) ... NÃO use: o Alembic depende de statements que
#     esse modo não mantém entre comandos.
# ----------------------------------------------------------------------------
DATABASE_URL=""

# Alternativa por campos separados. Só é lida quando DATABASE_URL está vazia.
DATABASE_HOST=aws-0-SUA_REGIAO.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres.SEU_PROJETO
DATABASE_PASSWORD=sua_senha_do_banco
DATABASE_SSLMODE=require

# ----------------------------------------------------------------------------
# Segredos da aplicação
# ----------------------------------------------------------------------------
# Assina o cookie de sessão (login e middleware de autenticação).
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_hex(32))"
USER_JWT_SECRET="troque_por_um_valor_aleatorio"
HMAC_SECRET_KEY="troque_por_um_valor_aleatorio"

# Envio do e-mail de recuperação de senha (opcional em dev)
SENDGRID_API_KEY="api_key"
SENDGRID_FROM_EMAIL="noreply@example.com"

# ----------------------------------------------------------------------------
# Z-API — o mesmo WhatsApp que o chatbot do n8n usa
#
# Avisa o cliente que o carro ficou pronto quando o pátio marca "Pronta".
# No painel da Z-API: ID da instância, Token da instância e, em Segurança da
# conta, o Client-Token.
#
# Deixe em branco para desligar o aviso: sem as três, o backend nem tenta a
# rede. É assim que dev não manda mensagem para cliente de verdade.
# ----------------------------------------------------------------------------
ZAPI_INSTANCE_ID=""
ZAPI_INSTANCE_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# Opcional: troca o endereço da Z-API. Serve para apontar para um servidor de
# teste. Em branco, usa https://api.z-api.io.
ZAPI_BASE_URL=""
